# Production — copy to .env on your Hetzner server (never commit .env)

NODE_ENV=production

ALCHEMY_KEY=your_alchemy_api_key
UNIVERSAL_ROUTER=0x8876789976dEcBfCbBbe364623C63652db8C0904

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# Set by docker-compose.prod.yml — do not use localhost inside the app container
# KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=transaction-tracker

HOST=0.0.0.0
PORT=3000

# Your frontend origin(s), comma-separated (not *)
CORS_ORIGIN=https://your-frontend.example.com
