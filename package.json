{
  "name": "transaction-tracker",
  "version": "1.0.0",
  "description": "Track Uniswap V4 swaps on Base via Alchemy WebSocket",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "node dist/server.js",
    "start:dev": "tsx server.ts",
    "build": "tsc",
    "create-topic": "tsx scripts/createKafkaTopic.ts",
    "kafka:up": "docker compose up -d --wait",
    "kafka:down": "docker compose down",
    "kafka:logs": "docker compose logs -f kafka",
    "kafka:setup": "docker compose up -d --wait && npm run create-topic",
    "kafka:reset": "docker compose down -v",
    "kafka:ui": "docker compose --profile ui up -d kafka-ui",
    "kafka:describe": "docker compose exec kafka kafka-topics --bootstrap-server localhost:9092 --describe --topic swap && docker compose exec kafka kafka-topics --bootstrap-server localhost:9092 --describe --topic swap-accelerated",
    "kafka:consume": "tsx scripts/consumeKafka.ts",
    "prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f app kafka"
  },
  "keywords": ["uniswap", "base", "alchemy", "kafka", "supabase"],
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "kafkajs": "^2.2.4",
    "viem": "^2.23.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
